# Local wishlist database; production uses environment variables supplied by hosting.
DATABASE_URL="postgresql://wishlist:wishlist-local@127.0.0.1:55432/wishlist_dev?schema=public"
DIRECT_URL="postgresql://wishlist:wishlist-local@127.0.0.1:55432/wishlist_dev?schema=public"
APP_URL="http://localhost:3000"

# Local inbox only. Unset MAILPIT_URL for real email delivery through Resend.
MAILPIT_URL="http://127.0.0.1:8025"
# RESEND_API_KEY=
EMAIL_FROM="Wishlist <onboarding@resend.dev>"

# Both Turnstile keys are required before deploying account forms to Vercel.
# Use a Managed Turnstile widget restricted to the deployment's APP_URL hostname.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional numerical performance monitoring. Disabled unless explicitly enabled.
# Collects numerical performance data without cookies or visitor identifiers.
# PERFORMANCE_MONITORING=1
# PERFORMANCE_SAMPLE_RATE=0.1

# Local background jobs. Unset INNGEST_DEV for hosted production.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Opt-in operator email for final background-job failures. Never a customer address.
# Uses the existing transactional email provider; unset disables sending.
# OPERATIONS_ALERT_EMAIL=support@wishlist.fi

# Local private files. Use vercel with a private Blob store when hosted.
MEDIA_STORAGE=local
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Local billing stays sandbox. Use matching live credentials only in production.
PADDLE_ENVIRONMENT=sandbox
# Set 1 to enable new checkout; 0 pauses sales without stopping billing recovery.
# Live requires explicit opt-in.
PADDLE_CHECKOUT_ENABLED=0
# Optional comma-separated app user IDs for controlled checkout tests.
# Unset/empty means all eligible users when checkout is enabled.
# PADDLE_CHECKOUT_TESTER_IDS=
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_MONTHLY_PRICE_ID=
# PADDLE_ANNUAL_PRICE_ID=
# Preserve legacy sandbox recovery when the primary environment becomes live.
# PADDLE_SANDBOX_API_KEY=
# PADDLE_SANDBOX_CLIENT_TOKEN=
# PADDLE_SANDBOX_WEBHOOK_SECRET=
# PADDLE_SANDBOX_MONTHLY_PRICE_ID=
# PADDLE_SANDBOX_ANNUAL_PRICE_ID=

# Displayed publicly in Terms/Privacy. Configure the actual operator before policy publication.
# OPERATOR_LEGAL_NAME=
