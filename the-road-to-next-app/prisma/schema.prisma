generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  username                String                   @unique @db.VarChar(40)
  email                   String                   @unique @db.VarChar(254)
  emailVerified           Boolean                  @default(false)
  passwordHash            String
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedLists              Wishlist[]               @relation("ListOwner")
  authoredWishes          Wish[]                   @relation("WishAuthor")
  memberships             Membership[]
  reservations            Reservation[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  userId    String   @id
  codeHash  String
  email     String   @db.VarChar(254)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Wishlist {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  title               String         @db.VarChar(200)
  description         String?        @db.VarChar(2000)
  publication         Publication    @default(DRAFT)
  visibility          ListVisibility @default(PUBLIC)
  reservationsEnabled Boolean        @default(false)
  archivedAt          DateTime?
  ownerId             String?
  owner               User?          @relation("ListOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  wishes              Wish[]

  @@index([ownerId, archivedAt, createdAt])
  @@index([visibility, publication, archivedAt, createdAt])
}

model Membership {
  id         String         @id @default(cuid())
  joinedAt   DateTime       @default(now())
  role       MembershipRole @default(MEMBER)
  wishlistId String
  userId     String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, userId])
  @@index([userId, joinedAt])
}

model Wish {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  title        String        @db.VarChar(200)
  description  String?       @db.VarChar(4000)
  externalUrl  String?       @db.VarChar(2048)
  priceMinor   Int?
  currency     Currency?
  priority     Int?          @db.SmallInt
  hidden       Boolean       @default(false)
  fulfilledAt  DateTime?
  wishlistId   String
  authorId     String?
  wishlist     Wishlist      @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  author       User?         @relation("WishAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reservations Reservation[]

  @@index([wishlistId, hidden, fulfilledAt, createdAt])
  @@index([authorId])
}

model Reservation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  wishId    String
  userId    String
  wish      Wish      @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index in the migration permits one active reservation per wish.
  @@index([wishId, endedAt])
  @@index([userId, endedAt, createdAt])
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum Publication {
  DRAFT
  PUBLISHED
}

enum ListVisibility {
  PUBLIC
  PRIVATE
}

enum Currency {
  EUR
  USD
  GBP
}
