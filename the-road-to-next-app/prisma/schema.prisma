generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  username                String                   @unique @db.VarChar(40)
  name                    String?                  @db.VarChar(80)
  description             String?                  @db.VarChar(1000)
  email                   String                   @unique @db.VarChar(254)
  emailVerified           Boolean                  @default(false)
  passwordHash            String
  image                   Media?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedLists              Wishlist[]               @relation("ListOwner")
  authoredWishes          Wish[]                   @relation("WishAuthor")
  memberships             Membership[]
  reservations            Reservation[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  userId    String   @id
  codeHash  String
  email     String   @db.VarChar(254)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Wishlist {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  title               String         @db.VarChar(200)
  description         String?        @db.VarChar(2000)
  publication         Publication    @default(DRAFT)
  visibility          ListVisibility @default(PUBLIC)
  reservationsEnabled Boolean        @default(false)
  archivedAt          DateTime?
  ownerId             String?
  owner               User?          @relation("ListOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  wishes              Wish[]
  image               Media?

  @@index([ownerId, archivedAt, createdAt])
  @@index([visibility, publication, archivedAt, createdAt])
}

model Membership {
  id         String         @id @default(cuid())
  joinedAt   DateTime       @default(now())
  role       MembershipRole @default(MEMBER)
  wishlistId String
  userId     String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, userId])
  @@index([userId, joinedAt])
}

model Wish {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  title        String        @db.VarChar(200)
  description  String?       @db.VarChar(4000)
  externalUrl  String?       @db.VarChar(2048)
  priceMinor   Int?
  currency     Currency?
  priority     Int?          @db.SmallInt
  hidden       Boolean       @default(false)
  fulfilledAt  DateTime?
  wishlistId   String
  authorId     String?
  wishlist     Wishlist      @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  author       User?         @relation("WishAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  image        Media?

  @@index([wishlistId, hidden, fulfilledAt, createdAt])
  @@index([authorId])
}

model Reservation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  wishId    String
  userId    String
  wish      Wish      @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index in the migration permits one active reservation per wish.
  @@index([wishId, endedAt])
  @@index([userId, endedAt, createdAt])
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum Publication {
  DRAFT
  PUBLISHED
}

enum ListVisibility {
  PUBLIC
  PRIVATE
}

enum Currency {
  EUR
  USD
  GBP
}

// Detached rows are the durable cleanup queue, including interrupted uploads.
model Media {
  id           String        @id @default(cuid())
  pathname     String        @unique
  provider     MediaProvider
  state        MediaState    @default(PENDING)
  alt          String        @db.VarChar(300)
  width        Int
  height       Int
  bytes        Int
  cleanupAfter DateTime
  attempts     Int           @default(0)
  wishlistId   String?       @unique
  wishId       String?       @unique
  userId       String?       @unique
  wishlist     Wishlist?     @relation(fields: [wishlistId], references: [id], onDelete: SetNull)
  wish         Wish?         @relation(fields: [wishId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cleanupAfter])
}

enum MediaProvider {
  LOCAL
  VERCEL
}

enum MediaState {
  PENDING
  READY
  DELETING
}
