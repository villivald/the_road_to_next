{
  "name": "the-road-to-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --fix",
    "type": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "email": "email dev --dir src/emails --port 3001",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:css && npm run format:check && npm run type && npm test",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migration": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555",
    "test:integration": "tsx scripts/e2e.ts --integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "db:rebuild:up": "docker compose -f compose.rebuild.yaml up -d --wait dev-db dev-mail",
    "db:rebuild:down": "docker compose -f compose.rebuild.yaml down"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "inngest": "^4.21.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "resend": "^6.30.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-email/ui": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "inngest-cli": "^1.45.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "overrides": {
    "inngest-cli": {
      "adm-zip": "^0.6.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.4"
    }
  }
}
