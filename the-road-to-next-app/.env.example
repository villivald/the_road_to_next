# Local PostgreSQL (see README). Use a separate database for development.
DATABASE_URL="postgresql://ticketbounty:ticketbounty@localhost:5432/ticketbounty?schema=public"
DIRECT_URL="postgresql://ticketbounty:ticketbounty@localhost:5432/ticketbounty?schema=public"
APP_URL="http://localhost:3000"

# Inngest local dev server. Remove INNGEST_DEV for hosted production.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Required for real verification, invitation, and password-reset emails.
# Leave RESEND_API_KEY unset until a real key is available.
# RESEND_API_KEY=
EMAIL_FROM="TicketBounty <onboarding@resend.dev>"

# Required for attachments. Keep the bucket private.
AWS_REGION="eu-north-1"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY=""
AWS_SECRET_KEY=""
